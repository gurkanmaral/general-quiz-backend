# Copy to apps/api/.env for local development (never commit .env).
DATABASE_URL=postgres://postgres@localhost:5432/kno
# Used only by `npm test` in apps/api; tables there are truncated between test files.
DATABASE_URL_TEST=postgres://postgres@localhost:5432/kno_test
PORT=8787
LOG_LEVEL=info
# Optional: folder holding quizzes/ and daily/ (defaults to the repo's content/).
# CONTENT_DIR=../../content
