# Copy to .env for local development (never commit .env).
DATABASE_URL=postgres://postgres@localhost:5432/kno
# Used only by `npm test`; tables there are truncated between test files.
DATABASE_URL_TEST=postgres://postgres@localhost:5432/kno_test
PORT=8787
LOG_LEVEL=info
# Optional: folder holding quizzes/ and daily/ (defaults to the repo's content/).
# CONTENT_DIR=../../content
# Public web origin (the Vite dev server proxies /api here). Links in emails point to it.
BETTER_AUTH_URL=http://localhost:5180
# Session signing secret, 32+ characters; required in production (openssl rand -base64 32).
# BETTER_AUTH_SECRET=
# Google sign-in appears only when both are set. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Email confirmation uses a 6-digit code. Outside production every code is AUTH_TEST_CODE
# (default 490909) and no email is sent. Production refuses this setting.
# AUTH_TEST_CODE=490909
# Production mail: sign-in emails go through Resend when set; otherwise links are only logged.
# RESEND_API_KEY=
# MAIL_FROM=KNO. <no-reply@kno.example>
# Comma-separated reverse-proxy IPs/CIDRs (real client IP for auth rate limits).
# TRUST_PROXY=
